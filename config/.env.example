# Copy this file to config/.env and fill in your API keys

# Google Gemini API (Free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# JSearch via RapidAPI (Optional - disabled by default, ~200 req/month free)
JSEARCH_API_KEY=

# Adzuna API (Optional - ~250 req/day free: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# The Muse API Key (Optional - works without key at 500 req/hr)
THE_MUSE_API_KEY=

# Discord Webhook URL (Optional - for notifications)
DISCORD_WEBHOOK_URL=
